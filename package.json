{
  "name": "flowproof-ai", "version": "0.1.0", "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24.0.0", "npm": ">=11.0.0"},
  "scripts": {
    "dev": "npm run dev --workspace @flowproof/desktop",
    "build": "npm run build --workspace @flowproof/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:win": "npm run build && npm run package:win --workspace @flowproof/desktop",
    "smoke:desktop": "node apps/desktop/test/smoke.mjs development",
    "smoke:dev-server": "node apps/desktop/test/smoke.mjs dev-server",
    "smoke:packaged": "node apps/desktop/test/smoke.mjs packaged"
  },
  "devDependencies": {
    "typescript": "5.9.3", "vitest": "4.0.18", "@types/node": "24.0.0",
    "@types/react": "19.2.0", "@types/react-dom": "19.2.0", "@types/ws": "8.18.1"
  }
}
