{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@flowproof/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@flowproof/browser-runtime": [
        "packages/browser-runtime/src/index.ts"
      ],
      "@flowproof/ai-providers": [
        "packages/ai-providers/src/index.ts"
      ],
      "@flowproof/persistence": [
        "packages/persistence/src/index.ts"
      ],
      "@flowproof/agent-core": [
        "packages/agent-core/src/index.ts"
      ]
    }
  }
}
